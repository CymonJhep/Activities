public class PatternGenerator {
    public static void main(String[] args) {
        int size = 6;

        for (int row = 1; row <= size; row++) {
            if (row == 3) {
                continue;
            }

            for (int col = 1; col <= row; col++) {
                if (col == 5) {
                    break;
                }
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
